{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://http-cli.dev/schemas/v1.0.0/help.schema.json",
  "title": "HTTP CLI help document",
  "description": "Shape of the data payload returned by a help request (GET ...?help=1) or by a GET on a group node. Discriminated by 'kind'.",
  "oneOf": [
    {
      "$ref": "#/$defs/groupHelp"
    },
    {
      "$ref": "#/$defs/commandHelp"
    }
  ],
  "$defs": {
    "nodeKind": {
      "type": "string",
      "enum": [
        "group",
        "command"
      ]
    },
    "pathPattern": {
      "description": "Command path below the Base URL: '/' for the root node, or a chain of naming-rule segments.",
      "pattern": "^(/)?$|^/([a-z][a-z0-9_-]*/?)+$"
    },
    "childRef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "path",
        "method",
        "summary"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nodeKind"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "path": {
          "$ref": "#/$defs/pathPattern"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "description": "GET for group nodes."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One-line description."
        },
        "deprecated": {
          "$ref": "#/$defs/deprecated"
        }
      },
      "additionalProperties": false
    },
    "deprecated": {
      "type": "object",
      "required": [
        "note"
      ],
      "properties": {
        "use_instead": {
          "type": "string",
          "description": "Path of the replacement node, if any."
        },
        "note": {
          "type": "string",
          "description": "Deprecation rationale and removal plan."
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": [
        "scheme",
        "header",
        "value_format"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "description": "e.g. bearer, api_key, signed_request."
        },
        "header": {
          "type": "string",
          "description": "Header name carrying the credential."
        },
        "value_format": {
          "type": "string",
          "description": "Exact expected format, e.g. 'Bearer <token>'."
        },
        "description": {
          "type": "string"
        },
        "obtain": {
          "type": "string",
          "description": "How a legitimate caller obtains a credential."
        }
      },
      "additionalProperties": true
    },
    "groupHelp": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "name",
        "method",
        "summary",
        "subcommands"
      ],
      "properties": {
        "kind": {
          "const": "group"
        },
        "path": {
          "$ref": "#/$defs/pathPattern"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "method": {
          "const": "GET"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "subcommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRef"
          },
          "description": "Direct children only; depth-limited for token economy."
        },
        "usage": {
          "type": "string",
          "description": "Human-readable invocation hint, e.g. 'GET {base}/note/<command>?help=1'."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecated": {
          "$ref": "#/$defs/deprecated"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Protocol version implemented by the server. Recommended on the root group help."
        },
        "server_version": {
          "type": "string",
          "description": "Implementation-specific version. Independent of protocol_version."
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        }
      },
      "additionalProperties": false
    },
    "commandHelp": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "name",
        "method",
        "summary",
        "params"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "path": {
          "$ref": "#/$defs/pathPattern"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "parameter.schema.json"
          },
          "description": "Every parameter the dispatcher accepts except the reserved 'help' and 'fields'."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "type": "string"
        },
        "deprecated": {
          "$ref": "#/$defs/deprecated"
        }
      },
      "additionalProperties": false
    }
  }
}
